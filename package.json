    "convex:deploy": "convex deploy",
    "media:deploy": "wrangler deploy --config media-worker/wrangler.jsonc"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "convex": "^1.42.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
