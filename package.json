{
  "name": "yabi-location",
  "version": "1.0.0",
  "private": true,
  "description": "YABI Location public website and Convex lead backend",
  "scripts": {
    "check": "tsc --noEmit",
    "check:media-worker": "tsc --noEmit -p media-worker/tsconfig.json",
