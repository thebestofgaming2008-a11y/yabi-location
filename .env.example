# Written automatically by `npx convex deployment create --select`.
CONVEX_DEPLOYMENT=
CONVEX_URL=

# Set in the Convex deployment, never in browser code.
CLIENT_ORIGIN=https://yabi-location.pages.dev
TURNSTILE_SECRET_KEY=
PORTAL_ACCESS_PEPPER=
MEDIA_SIGNING_SECRET=
MEDIA_CALLBACK_SECRET=
MEDIA_WORKER_URL=https://yabi-ops-media.example.workers.dev

# Set only for the one-time first administrator bootstrap, then remove it.
PORTAL_BOOTSTRAP_SECRET=

# Added when transactional email is enabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_NOTIFICATION_EMAIL=contact.yabilocation@gmail.com

# Cloudflare Worker secrets (must match the Convex values).
# MEDIA_SIGNING_SECRET=
# MEDIA_CALLBACK_SECRET=
